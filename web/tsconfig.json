{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    // One generated type tree, and only one.
    //
    // Every build writes its own `types/routes.d.ts`, and that file declares
    // `LayoutProps` globally with a constraint built from the route list as
    // it was *then*. Two of them in one program collide the moment they
    // disagree about which routes exist -- which is what happened: an e2e
    // tree that predated `app/dashboard/layout.tsx` said the only layout was
    // `/`, and the new one would not typecheck against it.
    //
    // `.next-auth` and `.next-e2e` are test build directories. Their types
    // are generated by a run that does not check them, and nothing here
    // typechecks against them, so they have no business in this program.
    // `**/*.ts` above reaches into them, so leaving them off the include
    // list was not enough.
    ".next-auth",
    ".next-e2e",
    ".next-probe"
  ]
}
